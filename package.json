{
  "name": "junkyard-empire",
  "private": true,
  "version": "0.6.0",
  "description": "Junkyard to Supercar Empire - an idle car tycoon game for web, iOS and Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run tests/balance.test.ts --reporter=verbose",
    "e2e": "NODE_PATH=$(npm root -g) node tools/e2e-smoke.cjs",
    "check": "npm run build && npm test && npm run e2e"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
