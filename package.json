{
  "name": "junkyard-empire",
  "private": true,
  "version": "0.12.0",
  "description": "Junkyard to Supercar Empire - an idle car tycoon game for web, iOS and Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run tests/balance.test.ts --reporter=verbose",
    "perf": "NODE_PATH=$(npm root -g) node tools/perf-probe.cjs",
    "e2e": "NODE_PATH=$(npm root -g) node tools/e2e-smoke.cjs",
    "check": "npm run build && npm test && npm run e2e",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.10",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
